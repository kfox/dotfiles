#!/usr/bin/env bash

command -v ffmpeg &> /dev/null || { echo "Install ffmpeg first!"; exit 1; }

usage() { echo "usage: $0 [--pal] <filename.mov>"; exit 1; }

# Width of a C64 pixel relative to its height on a real TV.
PIXEL_ASPECT=0.75
[ "$1" = "--pal" ] && { PIXEL_ASPECT=0.936; shift; }
[ $# -eq 1 ] || usage

# YouTube only gives uploads at least 1440 tall its higher-bitrate encodes.
OUTPUT_HEIGHT=1440
OUTPUT_WIDTH=$(awk -v h=$OUTPUT_HEIGHT -v par=$PIXEL_ASPECT \
  'BEGIN { printf "%d", int(h * 320 * par / 200 / 2) * 2 }')

INPUT="$1"
OUTPUT="${INPUT%.mov}.mp4"

echo "==> Analyzing ${INPUT} ..."

# cropdetect's limit is in the source's bit depth, so a 10-bit capture
# (black = 64) never reads as black at 24; detect on 8-bit luma instead.
DETECT_FILTER="format=gray"

# Upscalers like the RetroTINK leave a thin bright sync marker in the
# blanking, which stretches cropdetect's bounding box to the frame edge.
# A horizontal opening erases anything narrower than 2*THIN_LINE_PX
# while leaving wider areas their original size.
THIN_LINE_PX=8
for _ in $(seq $THIN_LINE_PX); do DETECT_FILTER+=",erosion=coordinates=24"; done
for _ in $(seq $THIN_LINE_PX); do DETECT_FILTER+=",dilation=coordinates=24"; done

# A black C64 border is indistinguishable from the blanking, so a single
# frame only shows how far its content reaches; the union over every frame
# is the whole picture.
CROP_FILTER=$(ffmpeg \
  -i "${INPUT}" \
  -vf "${DETECT_FILTER},cropdetect=limit=24:round=2:reset_count=1" \
  -f null - 2>&1 | \
  grep -o 'x1:[0-9]* x2:[0-9]* y1:[0-9]* y2:[0-9]*' | \
  awk -F'[: ]' '
    $4 > $2 && $8 > $6 {
      if (!n++ || $2 < x1) x1 = $2; if ($4 > x2) x2 = $4
      if (n == 1 || $6 < y1) y1 = $6; if ($8 > y2) y2 = $8
    }
    END {
      x1 -= x1 % 2; y1 -= y1 % 2
      w = x2 - x1 + 1; w += w % 2
      h = y2 - y1 + 1; h += h % 2
      printf "crop=%d:%d:%d:%d", w, h, x1, y1
    }')

echo "==> Processing using crop filter: ${CROP_FILTER}"

# scale keeps the input's display shape by adjusting the sample aspect
# ratio, so setsar=1 is what makes the new width take effect.
ffmpeg \
  -i "${INPUT}" \
  -vf "${CROP_FILTER},scale=${OUTPUT_WIDTH}:${OUTPUT_HEIGHT}:flags=lanczos,setsar=1" \
  -c:v libx264 -preset slow -crf 16 -tune animation \
  -pix_fmt yuv420p \
  -color_range tv -colorspace bt709 -color_primaries bt709 -color_trc bt709 \
  -c:a aac -b:a 320k \
  -movflags +faststart \
  "${OUTPUT}"

echo "==> Output saved as ${OUTPUT}"
