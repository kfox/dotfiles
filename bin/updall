#!/usr/bin/env bash

# homebrew
export HOMEBREW_INSTALL_CLEANUP=1 HOMEBREW_UPGRADE_CLEANUP=1 HOMEBREW_NO_ENV_HINTS=1
export PATH=$PATH:/opt/homebrew/bin

command -v brew >/dev/null && \
  brew ls && \
  brew update-if-needed && sleep 1 && \
  arch -arm64 brew upgrade --cask --yes && sleep 1 && \
  arch -arm64 brew upgrade --display-times --yes && sleep 1 && \
  brew autoremove && sleep 1 && \
  brew cleanup

# npm
if [ -n "$(command -v npm)" ]; then
  npm update --location=global --min-release-age=7
  npm outdated --location=global
fi

# mise
# hack to fix "Error getting latest version for python: git failed"
mise cache clear && \
  mise outdated --yes && \
  mise upgrade --bump --yes && \
  mise prune --yes
