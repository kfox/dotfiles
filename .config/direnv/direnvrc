#!/usr/bin/env bash

# shellcheck disable=SC2016,SC2155

# make direnv silent by default
export DIRENV_LOG_FORMAT=""

layout_poetry() {
  if [[ ! -f pyproject.toml ]]; then
    log_error 'No pyproject.toml found.  Use `poetry new` or `poetry init` to create one first.'
    exit 2
  fi

  local VENV=$(dirname "$(poetry run which python)")
  export VIRTUAL_ENV=$(echo "$VENV" | rev | cut -d'/' -f2- | rev)
  export POETRY_ACTIVE=1
  PATH_add "$VENV"
}

# Any arguments are passed through to `uv sync`, so a project that needs its
# extras can ask for them with `layout uv --all-extras`.
layout_uv() {
  if ! has uv; then
    log_error "bin \`uv\` not found"
    return 1
  fi

  export UV_PROJECT_ENVIRONMENT="$PWD/.venv"

  if [ -f "pyproject.toml" ]; then
    watch_file pyproject.toml uv.lock
    uv sync "$@" || log_error "uv sync failed; activating .venv as it stands"
  fi

  if [ ! -d "$UV_PROJECT_ENVIRONMENT" ]; then
    uv venv || return 1
  fi

  export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
  PATH_add "$UV_PROJECT_ENVIRONMENT/bin"
}

